[Unit]
Description=ZothOS Agent Budget Sentinel - Autonomous Token Cost Circuit Breaker & Guardrail
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
User=zoth
WorkingDirectory=/home/zoth/NullAITech/agent-budget-sentinel
ExecStart=/usr/bin/python3 /home/zoth/NullAITech/agent-budget-sentinel/bin/agent-budget serve --web-port 8110 --proxy-port 8111
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/zoth/NullAITech/agent-budget-sentinel/src

[Install]
WantedBy=multi-user.target
